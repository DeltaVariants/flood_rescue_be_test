{
  "id": null,
  "uid": "k6-flood-rescue",
  "title": "k6 Load Testing — Flood Rescue",
  "tags": ["k6", "performance"],
  "timezone": "browser",
  "refresh": "5s",
  "time": { "from": "now-5m", "to": "now" },
  "timepicker": {
    "time_options": ["1m", "2m", "3m", "5m", "15m", "30m", "1h", "6h", "12h", "24h", "2d", "7d", "30d"]
  },
  "panels": [
    {
      "id": 1,
      "title": "Virtual Users (VUs)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "influxdb", "uid": "P3C38336C5FADB351" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "P3C38336C5FADB351" },
          "query": "SELECT mean(\"value\") FROM \"vus\" WHERE $timeFilter GROUP BY time($__interval) fill(null)",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "Active VUs"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 20 }
        }
      },
      "options": { "tooltip": { "mode": "single" }, "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 2,
      "title": "Requests per Second",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "influxdb", "uid": "P3C38336C5FADB351" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "P3C38336C5FADB351" },
          "query": "SELECT sum(\"value\") FROM \"http_reqs\" WHERE $timeFilter GROUP BY time($__interval) fill(0)",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "req/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "#5794F2", "mode": "fixed" },
          "custom": { "lineWidth": 2, "fillOpacity": 15 },
          "unit": "reqps"
        }
      },
      "options": { "tooltip": { "mode": "single" }, "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 3,
      "title": "Response Time (ms)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "influxdb", "uid": "P3C38336C5FADB351" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "P3C38336C5FADB351" },
          "query": "SELECT mean(\"value\") FROM \"http_req_duration\" WHERE $timeFilter GROUP BY time($__interval) fill(null)",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "avg"
        },
        {
          "refId": "B",
          "datasource": { "type": "influxdb", "uid": "P3C38336C5FADB351" },
          "query": "SELECT percentile(\"value\", 95) FROM \"http_req_duration\" WHERE $timeFilter GROUP BY time($__interval) fill(null)",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "p95"
        },
        {
          "refId": "C",
          "datasource": { "type": "influxdb", "uid": "P3C38336C5FADB351" },
          "query": "SELECT max(\"value\") FROM \"http_req_duration\" WHERE $timeFilter GROUP BY time($__interval) fill(null)",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "max"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "ms"
        }
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 4,
      "title": "Failed Requests",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "influxdb", "uid": "P3C38336C5FADB351" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "P3C38336C5FADB351" },
          "query": "SELECT sum(\"value\") FROM \"http_req_failed\" WHERE $timeFilter GROUP BY time($__interval) fill(0)",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "failed"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "#F2495C", "mode": "fixed" },
          "custom": { "lineWidth": 2, "fillOpacity": 20 }
        }
      },
      "options": { "tooltip": { "mode": "single" }, "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 5,
      "title": "Avg Response Time",
      "type": "stat",
      "gridPos": { "x": 0, "y": 16, "w": 4, "h": 4 },
      "datasource": { "type": "influxdb", "uid": "P3C38336C5FADB351" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "P3C38336C5FADB351" },
          "query": "SELECT mean(\"value\") FROM \"http_req_duration\" WHERE $timeFilter",
          "rawQuery": true,
          "resultFormat": "time_series"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 300 }, { "color": "red", "value": 500 }] } } },
      "options": { "reduceOptions": { "calcs": ["mean"] }, "orientation": "auto", "textMode": "auto", "colorMode": "background" }
    },
    {
      "id": 6,
      "title": "p95 Response Time",
      "type": "stat",
      "gridPos": { "x": 4, "y": 16, "w": 4, "h": 4 },
      "datasource": { "type": "influxdb", "uid": "P3C38336C5FADB351" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "P3C38336C5FADB351" },
          "query": "SELECT percentile(\"value\", 95) FROM \"http_req_duration\" WHERE $timeFilter",
          "rawQuery": true,
          "resultFormat": "time_series"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 500 }, { "color": "red", "value": 800 }] } } },
      "options": { "reduceOptions": { "calcs": ["last"] }, "orientation": "auto", "textMode": "auto", "colorMode": "background" }
    },
    {
      "id": 7,
      "title": "Max Response Time",
      "type": "stat",
      "gridPos": { "x": 8, "y": 16, "w": 4, "h": 4 },
      "datasource": { "type": "influxdb", "uid": "P3C38336C5FADB351" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "P3C38336C5FADB351" },
          "query": "SELECT max(\"value\") FROM \"http_req_duration\" WHERE $timeFilter",
          "rawQuery": true,
          "resultFormat": "time_series"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 800 }, { "color": "red", "value": 1500 }] } } },
      "options": { "reduceOptions": { "calcs": ["max"] }, "orientation": "auto", "textMode": "auto", "colorMode": "background" }
    },
    {
      "id": 8,
      "title": "Total Requests",
      "type": "stat",
      "gridPos": { "x": 12, "y": 16, "w": 4, "h": 4 },
      "datasource": { "type": "influxdb", "uid": "P3C38336C5FADB351" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "P3C38336C5FADB351" },
          "query": "SELECT sum(\"value\") FROM \"http_reqs\" WHERE $timeFilter",
          "rawQuery": true,
          "resultFormat": "time_series"
        }
      ],
      "fieldConfig": { "defaults": { "color": { "fixedColor": "#5794F2", "mode": "fixed" } } },
      "options": { "reduceOptions": { "calcs": ["sum"] }, "orientation": "auto", "textMode": "auto", "colorMode": "background" }
    },
    {
      "id": 9,
      "title": "Max VUs",
      "type": "stat",
      "gridPos": { "x": 16, "y": 16, "w": 4, "h": 4 },
      "datasource": { "type": "influxdb", "uid": "P3C38336C5FADB351" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "P3C38336C5FADB351" },
          "query": "SELECT max(\"value\") FROM \"vus\" WHERE $timeFilter",
          "rawQuery": true,
          "resultFormat": "time_series"
        }
      ],
      "fieldConfig": { "defaults": { "color": { "fixedColor": "#73BF69", "mode": "fixed" } } },
      "options": { "reduceOptions": { "calcs": ["max"] }, "orientation": "auto", "textMode": "auto", "colorMode": "background" }
    },
    {
      "id": 10,
      "title": "Failure Rate",
      "type": "stat",
      "gridPos": { "x": 20, "y": 16, "w": 4, "h": 4 },
      "datasource": { "type": "influxdb", "uid": "P3C38336C5FADB351" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "P3C38336C5FADB351" },
          "query": "SELECT mean(\"value\") FROM \"http_req_failed\" WHERE $timeFilter GROUP BY time($__interval) fill(0)",
          "rawQuery": true,
          "resultFormat": "time_series"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 0.01 }] } } },
      "options": { "reduceOptions": { "calcs": ["mean"] }, "orientation": "auto", "textMode": "auto", "colorMode": "background" }
    }
  ],
  "schemaVersion": 38
}